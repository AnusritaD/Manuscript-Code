## Scripts for Figure 04
"""
Q6: At What Level Are Courses Being Offered? -- Venn Diagram (Unique Institute Distribution)
Run this in Google Colab.

Extracts institute-level course-level categories from Q6 (multi-select,
comma-separated), collapses multiple respondents per institute into one
combined set of levels per institute, groups '3-yr' and '4-yr/Hons'
Bachelor's variants together, groups 'Diploma' and 'Certificate' together,
and builds a 3-set Venn diagram (Bachelor's / Master's / Diploma-Certificate)
plus a side-by-side bar chart of totals. PhD responses are checked for but
excluded since none were found in the data.
"""

import os
from collections import Counter

import pandas as pd
import matplotlib.pyplot as plt
from matplotlib_venn import venn3
from matplotlib_venn.layout.venn3 import DefaultLayoutAlgorithm

# ------------------------------------------------------------------
# 1. Load data (auto-prompts for upload in Colab if not already present)
# ------------------------------------------------------------------
CSV_FILENAME = 'All_in_one_corrected.csv'

if not os.path.exists(CSV_FILENAME):
    try:
        from google.colab import files
        print(f"'{CSV_FILENAME}' not found in the Colab runtime.")
        print("A file picker will open -- please select your CSV file.")
        uploaded = files.upload()
        CSV_FILENAME = next(iter(uploaded))
    except ImportError:
        raise FileNotFoundError(
            f"'{CSV_FILENAME}' not found. Place the CSV in the working "
            f"directory, or update CSV_FILENAME to the correct path."
        )

df = pd.read_csv(CSV_FILENAME)

# ------------------------------------------------------------------
# 2. Identify columns
# ------------------------------------------------------------------
inst_col = "Institute's Name: "
q6_col = [c for c in df.columns if c.strip().startswith('Q6.')][0]
print("Institute column:", repr(inst_col))
print("Q6 column       :", repr(q6_col))

# ------------------------------------------------------------------
# 3. Categorize each response into Bachelor's / Master's / Diploma-Certificate / PhD
#    - Bachelor's Degree: "Bachelor's Degree - 3 years" OR
#      "Bachelor's Degree (Honours / with Research) - 4 years" -> merged into one group
#    - Master's Degree
#    - Diploma / Certificate: "Diploma course - 2 years" OR "Certificate course - 1 year"
#      -> merged into one group
#    - PhD: checked for but not present in this dataset
# ------------------------------------------------------------------
sub = df[[inst_col, q6_col]].dropna(subset=[inst_col, q6_col]).copy()

def categorize(value):
    parts = [p.strip() for p in str(value).split(',') if p.strip()]
    cats = set()
    for p in parts:
        pl = p.lower().replace('\u2019', "'").replace('?', "'")  # normalize curly quotes
        if 'bachelor' in pl:
            cats.add("Bachelor's Degree")
        elif 'master' in pl:
            cats.add("Master's Degree")
        elif 'diploma' in pl or 'certificate' in pl:
            cats.add('Diploma / Certificate')
        elif 'phd' in pl or 'doctoral' in pl:
            cats.add('PhD')
    return cats

sub['levels'] = sub[q6_col].apply(categorize)

institute_levels = (
    sub.groupby(inst_col)['levels']
       .apply(lambda series: set().union(*series))
)
total_institutes = len(institute_levels)
print(f"\nTotal unique institutes (answered Q6): {total_institutes}")

