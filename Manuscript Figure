Run this in Google Colab.

Extracts institute-level equipment categories from Q16 (multi-select,
comma-separated), collapses multiple respondents per institute into one
combined set per institute, and counts how many institutes fall into each
category. "Other / Not Specified" is only counted for institutes where it
is the ONLY category reported (i.e. no real equipment category was also
given) -- matching the reference chart's logic.
"""

import os
from collections import Counter

import pandas as pd
import matplotlib.pyplot as plt

# ------------------------------------------------------------------
# 1. Load data (auto-prompts for upload in Colab if not already present)
# ------------------------------------------------------------------
CSV_FILENAME = 'All_in_one_corrected.csv'

if not os.path.exists(CSV_FILENAME):
    try:
        from google.colab import files
        print(f"'{CSV_FILENAME}' not found in the Colab runtime.")
        print("A file picker will open -- please select your CSV file.")
        uploaded = files.upload()
        CSV_FILENAME = next(iter(uploaded))
    except ImportError:
        raise FileNotFoundError(
            f"'{CSV_FILENAME}' not found. Place the CSV in the working "
            f"directory, or update CSV_FILENAME to the correct path."
        )

df = pd.read_csv(CSV_FILENAME)

# ------------------------------------------------------------------
# 2. Identify columns
# ------------------------------------------------------------------
inst_col = "Institute's Name: "
q16_col = [c for c in df.columns if c.strip().startswith('Q16.')][0]
print("Institute column:", repr(inst_col))
print("Q16 column      :", repr(q16_col))

OTHER_LABEL = 'Other / Not Specified'

# ------------------------------------------------------------------
# 3. Build institute-level category sets
#    Each response is a comma-separated list of category labels. Multiple
#    respondents per institute are unioned into a single set per institute.
# ------------------------------------------------------------------
sub = df[[inst_col, q16_col]].dropna(subset=[inst_col, q16_col]).copy()

def parse_categories(value):
    return {p.strip() for p in str(value).split(',') if p.strip()}

sub['categories'] = sub[q16_col].apply(parse_categories)

institute_categories = (
    sub.groupby(inst_col)['categories']
       .apply(lambda series: set().union(*series))
)
institute_categories = institute_categories[institute_categories.apply(len) > 0]
total_institutes = len(institute_categories)
print(f"\nTotal unique institutes (answered Q16): {total_institutes}")

# ------------------------------------------------------------------
# 4. Count institutes per category.
#    "Other / Not Specified" only counts institutes where it's the SOLE
#    category (i.e. no specific equipment category was also mentioned).
#    All other categories count every institute that mentioned them,
#    regardless of what else was mentioned.
# ------------------------------------------------------------------
counts = Counter()
for cats in institute_categories:
    if cats == {OTHER_LABEL}:
        counts[OTHER_LABEL] += 1
    for cat in cats:
        if cat != OTHER_LABEL:
            counts[cat] += 1

category_counts = (
    pd.Series(counts)
      .sort_values(ascending=False)
      .rename('Count')
