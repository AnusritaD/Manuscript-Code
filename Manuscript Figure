ax.axvline(0, color='black', linewidth=1)
ax.tick_params(axis='y', labelsize=13)
for label in ax.get_yticklabels():
    label.set_fontweight('bold')

# Legend (category -> color), largest-first order
legend_order = plot_data.index[::-1]
handles = [plt.Rectangle((0, 0), 1, 1, color=color_map.get(cat, '#999999')) for cat in legend_order]
