## Scripts for Figure 01
"""
Course Offerings Overview
(Combined: Course Offerings Yes/No  +  Q5 Courses Listed by Institutions)
Run this in Google Colab.

Merges the two previously separate charts into a single two-panel figure:
  - Left  : institute-level Yes/No summary for "Does your department offer
            courses related to evolution/ecology/wildlife genetics/..."  (Q4)
  - Right : Q5 course-category breakdown (comma-separated multi-select,
            counted per institute mention)
"""

import os
from collections import Counter

import pandas as pd
import matplotlib.pyplot as plt

# ------------------------------------------------------------------
# 1. Load data (auto-prompts for upload in Colab if not already present)
# ------------------------------------------------------------------
CSV_FILENAME = 'All_in_one_corrected.csv'

if not os.path.exists(CSV_FILENAME):
    try:
        from google.colab import files
        print(f"'{CSV_FILENAME}' not found in the Colab runtime.")
        print("A file picker will open -- please select your CSV file.")
        uploaded = files.upload()
        CSV_FILENAME = next(iter(uploaded))
    except ImportError:
        raise FileNotFoundError(
            f"'{CSV_FILENAME}' not found. Place the CSV in the working "
            f"directory, or update CSV_FILENAME to the correct path."
        )

df = pd.read_csv(CSV_FILENAME)

inst_col = "Institute's Name: "

# ==================================================================
# PANEL 1 DATA -- Q4: Course Offerings Yes/No (institute-level)
# ==================================================================
q4_col = [c for c in df.columns if 'Q4.' in c and 'currently offer courses' in c][0]

sub4 = df[[inst_col, q4_col]].dropna(subset=[inst_col]).copy()
sub4[q4_col] = sub4[q4_col].astype(str).str.strip()

def institute_status(vals):
    if (vals == 'Yes').any():
        return 'Yes'
    elif (vals == 'No').any():
        return 'No'
    else:
        return 'Unknown'

institute_summary = sub4.groupby(inst_col)[q4_col].apply(institute_status)

counts4 = institute_summary.value_counts()
yes_inst = counts4.get('Yes', 0)
no_inst = counts4.get('No', 0)
responded_inst = yes_inst + no_inst  # denominator matches the reference: Yes+No only

yes_pct = yes_inst / responded_inst * 100 if responded_inst else 0
no_pct = no_inst / responded_inst * 100 if responded_inst else 0

print("Panel 1 - Course Offerings (Q4):")
print(f"  Yes: {yes_inst} ({yes_pct:.1f}%)   No: {no_inst} ({no_pct:.1f}%)   Total: {responded_inst}")

# ==================================================================
# PANEL 2 DATA -- Q5: Courses Listed by Institutions
# ==================================================================
q5_col = [c for c in df.columns if c.strip().startswith('Q5.')][0]

responses5 = df[q5_col].dropna()
counts5 = Counter()
for entry in responses5:
    for cat in [c.strip() for c in str(entry).split(',') if c.strip()]:
        counts5[cat] += 1

course_counts = pd.Series(counts5).sort_values(ascending=False)
print("\nPanel 2 - Course categories (Q5):")
print(course_counts)

# ------------------------------------------------------------------
# 2. Plot -- combined two-panel figure
# ------------------------------------------------------------------
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(18, 8), gridspec_kw={'width_ratios': [1, 1.4]})
fig.suptitle('Course Offerings Overview', fontsize=20, fontweight='bold', y=1.02)

# --- Panel 1: Yes vs No ---
labels1 = ['Yes\n(Offers Course)', 'No\n(Does Not Offer)']
vals1 = [yes_inst, no_inst]
pcts1 = [yes_pct, no_pct]
colors1 = ['#3d5a80', '#c1444d']

bars1 = ax1.bar(labels1, vals1, color=colors1, width=0.5)
for bar, v, p in zip(bars1, vals1, pcts1):
    ax1.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + max(vals1) * 0.02,
              f"{v} Institutes\n({p:.1f}%)", ha='center', va='bottom',
              fontsize=12, fontweight='bold')

ax1.set_ylim(0, max(vals1) * 1.30)
ax1.set_title('Course Offerings\n(Yes vs No)', fontsize=14, fontweight='bold')
for spine in ['top', 'right']:
    ax1.spines[spine].set_visible(False)
ax1.axhline(0, color='black', linewidth=1)

# --- Panel 2: Q5 course categories (horizontal bar) ---
plot_data = course_counts.sort_values(ascending=True)  # smallest at bottom for barh

color_map = {
    'Behavioral Studies': '#1f6bb0',
    'Basic Biology': '#aec6e8',
    'Biotechnology': '#f7a94a',
    'Wildlife': '#8fd07d',
    'Molecular Biology': '#f4867e',
    'Environmental Science': '#c9b8de',
    'Others': '#8c564b',
    'Conservation Biology': '#d63bbf',
    'Evolution': '#7f7f7f',
    'Ecology': '#c6c81e',
    'Bioinformatics & Omics technologies': '#12b3c9',
    'Genetics': '#a6dceb',
}
colors2 = [color_map.get(idx, '#999999') for idx in plot_data.index]

bars2 = ax2.barh(plot_data.index, plot_data.values, color=colors2,
                  edgecolor='black', linewidth=0.6)
for bar, v in zip(bars2, plot_data.values):
    ax2.text(bar.get_width() + max(plot_data.values) * 0.01,
              bar.get_y() + bar.get_height() / 2,
              f"{v}", va='center', ha='left', fontsize=11, fontweight='bold')

ax2.set_xlabel('Number of Institutions Offering the Course', fontsize=12)
ax2.set_title('Courses Listed by Institutions', fontsize=14, fontweight='bold')
ax2.set_xlim(0, max(plot_data.values) * 1.15)
for spine in ['top', 'right', 'left']:
    ax2.spines[spine].set_visible(False)
ax2.axvline(0, color='black', linewidth=1)

plt.tight_layout()
plt.savefig('course_offerings_overview.tif', dpi=300, format='tiff', bbox_inches='tight')
plt.savefig('course_offerings_overview.png', dpi=200, bbox_inches='tight')
plt.show()

print("\n✅ Chart saved as course_offerings_overview.tif (HD) and course_offerings_overview.png (preview)")

