## Scripts for Figure 03
"""
Integration of Genetics & Heredity vs Big Data & Genomics into
Evolutionary Biology Courses (Q7 vs Q8, merged grouped bar chart)
Run this in Google Colab.

Combines Q7 ("To what extent are concepts from genetics and heredity
integrated...") and Q8 ("To what extent are big data and genomics concepts
integrated...") into one grouped bar chart, comparing the two side by
side for each integration level. Both questions allow multiple selections
per response and have option labels containing internal commas, so
selections are matched by canonical phrase (not comma-split) and unioned
per institute. Percentages for both series are of each question's own
total unique institutes (Q7: n=102, Q8: n=103).
"""

import os
from collections import Counter

import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# ------------------------------------------------------------------
# 1. Load data (auto-prompts for upload in Colab if not already present)
# ------------------------------------------------------------------
CSV_FILENAME = 'All_in_one_corrected.csv'

if not os.path.exists(CSV_FILENAME):
    try:
        from google.colab import files
        print(f"'{CSV_FILENAME}' not found in the Colab runtime.")
        print("A file picker will open -- please select your CSV file.")
        uploaded = files.upload()
        CSV_FILENAME = next(iter(uploaded))
    except ImportError:
        raise FileNotFoundError(
            f"'{CSV_FILENAME}' not found. Place the CSV in the working "
            f"directory, or update CSV_FILENAME to the correct path."
        )

df = pd.read_csv(CSV_FILENAME)
inst_col = "Institute's Name: "

LEVELS = [
    'Extensively (e.g., a full course)',
    'Moderately (e.g., a dedicated module)',
    'Minimally (e.g., a few lectures)',
    'Not at all',
]

def parse_levels(value):
    text = str(value)
    return {lvl for lvl in LEVELS if lvl in text}

def institute_level_counts(question_col):
    """Return (level_counts Series indexed by LEVELS, total_unique_institutes)."""
    sub = df[[inst_col, question_col]].dropna(subset=[inst_col, question_col]).copy()
    sub['levels'] = sub[question_col].apply(parse_levels)
    inst_levels = sub.groupby(inst_col)['levels'].apply(lambda s: set().union(*s))
    inst_levels = inst_levels[inst_levels.apply(len) > 0]
    total_institutes = len(inst_levels)

    counts = Counter()
    for levels in inst_levels:
        for lvl in levels:
            counts[lvl] += 1
    level_counts = pd.Series(counts).reindex(LEVELS).fillna(0).astype(int)
    return level_counts, total_institutes

# ------------------------------------------------------------------
# 2. Compute Q7 and Q8 institute-level counts
# ------------------------------------------------------------------
q7_col = [c for c in df.columns if 'Q7.' in c][0]
q8_col = [c for c in df.columns if 'Q8.' in c][0]

q7_counts, q7_total = institute_level_counts(q7_col)
q8_counts, q8_total = institute_level_counts(q8_col)

# Percentages are of each question's own total unique institutes
q7_pcts = q7_counts / q7_total * 100
q8_pcts = q8_counts / q8_total * 100

print(f"Q7 (Genetics & Heredity): n={q7_total} institutes")
print(q7_counts)
print(f"\nQ8 (Big Data & Genomics): n={q8_total} institutes")
print(q8_counts)

# ------------------------------------------------------------------
# 3. Plot -- grouped vertical bar chart
# ------------------------------------------------------------------
short_labels = ['Extensively\n(e.g., a full course)', 'Moderately\n(e.g., a dedicated module)',
                 'Minimally\n(e.g., a few lectures)', 'Not at all']

x = np.arange(len(LEVELS))
width = 0.38

fig, ax = plt.subplots(figsize=(15, 10))

bars1 = ax.bar(x - width / 2, q7_counts.values, width,
                label=f'Genetics & Heredity (n={q7_total} institutes)', color='#1f77b4')
bars2 = ax.bar(x + width / 2, q8_counts.values, width,
                label=f'Big Data & Genomics (n={q8_total} institutes)', color='#f5a623')

max_count = max(q7_counts.max(), q8_counts.max())
for bar, v, p in zip(bars1, q7_counts.values, q7_pcts.values):
    ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + max_count * 0.015,
            f"{p:.1f}%", ha='center', va='bottom', fontsize=13, fontweight='bold', color='#333333')
    ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() / 2, f"{v}",
            ha='center', va='center', fontsize=15, fontweight='bold', color='white')
for bar, v, p in zip(bars2, q8_counts.values, q8_pcts.values):
    ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + max_count * 0.015,
            f"{p:.1f}%", ha='center', va='bottom', fontsize=13, fontweight='bold', color='#333333')
    ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() / 2, f"{v}",
            ha='center', va='center', fontsize=15, fontweight='bold', color='white')

ax.set_xticks(x)
ax.set_xticklabels(short_labels, fontsize=12)
ax.set_ylabel('Number of Institutes / Responses', fontsize=13)
ax.set_xlabel('Level of Integration', fontsize=13)
ax.set_title('Integration of Genetics & Heredity vs Big Data & Genomics\n'
              'into Evolutionary Biology Courses', fontsize=18, fontweight='bold')
ax.set_ylim(0, max_count * 1.25)
for spine in ['top', 'right']:
    ax.spines[spine].set_visible(False)
ax.axhline(0, color='black', linewidth=1)
ax.legend(loc='upper right', fontsize=12, frameon=True)

plt.tight_layout(rect=[0, 0.04, 1, 1])
plt.savefig('q7_vs_q8_integration.tif', dpi=300, format='tiff', bbox_inches='tight')
plt.savefig('q7_vs_q8_integration.png', dpi=200, bbox_inches='tight')
plt.show()

print("\n✅ Chart saved as q7_vs_q8_integration.tif (HD) and q7_vs_q8_integration.png (preview)")

