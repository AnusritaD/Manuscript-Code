## Scripts for Figure 02
"""
Specific Topics Within Genomics Covered in Curriculum -- UpSet Plot
Run this in Google Colab.

Extracts institute-level topic combinations from Q9 (multi-select,
comma-separated), collapses multiple respondents per institute into one
combined topic set, drops "None of the above", and builds a custom
UpSet-style plot: exact-combination bar chart on top, a topic membership
matrix in the middle, and per-topic totals as a horizontal bar chart
on the left.
"""

import os
from collections import Counter
from itertools import combinations

import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec

# ------------------------------------------------------------------
# 1. Load data (auto-prompts for upload in Colab if not already present)
# ------------------------------------------------------------------
CSV_FILENAME = 'All_in_one_corrected.csv'

if not os.path.exists(CSV_FILENAME):
    try:
        from google.colab import files
        print(f"'{CSV_FILENAME}' not found in the Colab runtime.")
        print("A file picker will open -- please select your CSV file.")
        uploaded = files.upload()
        CSV_FILENAME = next(iter(uploaded))
    except ImportError:
        raise FileNotFoundError(
            f"'{CSV_FILENAME}' not found. Place the CSV in the working "
            f"directory, or update CSV_FILENAME to the correct path."
        )

df = pd.read_csv(CSV_FILENAME)

# ------------------------------------------------------------------
# 2. Identify columns
# ------------------------------------------------------------------
inst_col = "Institute's Name: "
q9_col = [c for c in df.columns if c.strip().startswith('Q9.')][0]
print("Institute column:", repr(inst_col))
print("Q9 column       :", repr(q9_col))

# ------------------------------------------------------------------
# 3. Build institute-level topic sets
#    Each response is a comma-separated list of topics, e.g.
#    "NGS technologies, Bioinformatics, Phylogenomics". Some institutes
#    have multiple respondents -- union their topics into one set per
#    institute. "None of the above" is dropped (it means no topics).
# ------------------------------------------------------------------
sub = df[[inst_col, q9_col]].dropna(subset=[inst_col, q9_col]).copy()

def parse_topics(value):
    parts = [p.strip() for p in str(value).split(',') if p.strip()]
    return {p for p in parts if p.lower() != 'none of the above'}

sub['topics'] = sub[q9_col].apply(parse_topics)

institute_topics = (
    sub.groupby(inst_col)['topics']
       .apply(lambda series: set().union(*series))
)

# Keep only institutes that reported at least one topic
institute_topics = institute_topics[institute_topics.apply(len) > 0]
total_institutes = len(institute_topics)
print(f"\nTotal unique institutes (with >=1 topic): {total_institutes}")

# ------------------------------------------------------------------
# 4. Count exact combinations
# ------------------------------------------------------------------
TOPIC_ORDER = ['Bioinformatics', 'Phylogenomics', 'NGS technologies',
               'Genome assembly', 'Others']

combo_counts = Counter(frozenset(s) for s in institute_topics)
combo_counts = dict(sorted(combo_counts.items(), key=lambda kv: -kv[1]))

print("\nExact combinations:")
for combo, count in combo_counts.items():
    ordered = [t for t in TOPIC_ORDER if t in combo]
    print(f"  {count:>3}  {', '.join(ordered)}")

# ------------------------------------------------------------------
# 5. Per-topic totals (for the left-side bar panel)
# ------------------------------------------------------------------
topic_totals = {t: sum(1 for s in institute_topics if t in s) for t in TOPIC_ORDER}

# ------------------------------------------------------------------
# 6. Classify each combination for bar coloring
#    - green : "Bioinformatics" alone
#    - red   : contains Bioinformatics + NGS technologies + Phylogenomics
#              together (regardless of any other topics present)
#    - blue  : everything else (general combination)
# ------------------------------------------------------------------
CORE_TRIO = {'Bioinformatics', 'NGS technologies', 'Phylogenomics'}

def classify(combo):
    if combo == {'Bioinformatics'}:
        return 'green'
    if CORE_TRIO.issubset(combo):
        return 'red'
    return 'blue'

COLOR_HEX = {'red': '#E4726A', 'green': '#3E9B4F', 'blue': '#1f6bb0'}

combos = list(combo_counts.keys())
counts = list(combo_counts.values())
bar_colors = [COLOR_HEX[classify(c)] for c in combos]

# ------------------------------------------------------------------
# 7. Plot -- UpSet-style figure
# ------------------------------------------------------------------
n_combos = len(combos)
n_topics = len(TOPIC_ORDER)

fig = plt.figure(figsize=(16, 10))
gs = gridspec.GridSpec(
    2, 3,
    width_ratios=[1, 1.15, 4.2],
    height_ratios=[2.3, 1.6],
    wspace=0.05, hspace=0.05
)

ax_bar = fig.add_subplot(gs[0, 2])          # top-right: combination bar chart
ax_matrix = fig.add_subplot(gs[1, 2], sharex=ax_bar)   # bottom-right: membership matrix
ax_labels = fig.add_subplot(gs[1, 1], sharey=ax_matrix)  # bottom-middle: topic name labels
ax_totals = fig.add_subplot(gs[1, 0], sharey=ax_matrix)  # bottom-left: per-topic totals

x = range(n_combos)

# --- Top bar chart ---
bars = ax_bar.bar(x, counts, color=bar_colors, width=0.6)
for xi, c in zip(x, counts):
    ax_bar.text(xi, c + max(counts) * 0.02, str(c),
                ha='center', va='bottom', fontsize=14, fontweight='bold')
ax_bar.set_ylabel('Number of Institutes', fontsize=13)
ax_bar.spines[['top', 'right']].set_visible(False)
ax_bar.axhline(0, color='black', linewidth=1)
ax_bar.tick_params(axis='x', bottom=False, labelbottom=False)
fig.suptitle('Specific Topics Within Genomics Covered in Curriculum\nUpSet Plot',
             fontsize=22, fontweight='bold', y=0.98)

# --- Matrix (dot/line) panel ---
for row_i, topic in enumerate(TOPIC_ORDER):
    y = n_topics - 1 - row_i  # top row = first topic
    ax_matrix.axhspan(y - 0.5, y + 0.5,
                       color='#f2f2f2' if row_i % 2 == 0 else 'white', zorder=0)

for col_i, combo in enumerate(combos):
    member_rows = [n_topics - 1 - TOPIC_ORDER.index(t) for t in TOPIC_ORDER if t in combo]
    color = bar_colors[col_i]
    if len(member_rows) > 1:
        ax_matrix.plot([col_i, col_i], [min(member_rows), max(member_rows)],
                        color=color, linewidth=2.5, zorder=1)
    for row_i in range(n_topics):
        y = n_topics - 1 - row_i
        is_member = TOPIC_ORDER[row_i] in combo
        ax_matrix.scatter(col_i, y,
                           s=220 if is_member else 140,
                           color=color if is_member else '#d9dee3',
                           zorder=2, edgecolors='none')

ax_matrix.set_yticks(range(n_topics))
ax_matrix.set_yticklabels([])
ax_matrix.set_xticks(x)
ax_matrix.set_xticklabels([])
ax_matrix.set_xlim(-0.6, n_combos - 0.4)
ax_matrix.set_ylim(-0.6, n_topics - 0.4)
for spine in ax_matrix.spines.values():
    spine.set_visible(False)
ax_matrix.tick_params(left=False, bottom=False)

# Topic name labels, drawn in their own axis so they always render in full.
for row_i, topic in enumerate(TOPIC_ORDER):
    y = n_topics - 1 - row_i
    ax_labels.text(1.0, y, topic, ha='right', va='center', fontsize=13)
ax_labels.set_xlim(0, 1)
ax_labels.axis('off')

# --- Left panel: per-topic totals ---
totals_ordered = [topic_totals[t] for t in TOPIC_ORDER[::-1]]  # match matrix row order
ax_totals.barh(range(n_topics), totals_ordered, color='#1f6bb0', height=0.6)
ax_totals.invert_xaxis()
ax_totals.set_xlabel('Total Institutes\nCovering Topic', fontsize=10)
ax_totals.tick_params(left=False, labelleft=False)
for spine in ['top', 'left']:
    ax_totals.spines[spine].set_visible(False)

# ------------------------------------------------------------------
# 8. Legend + footer
# ------------------------------------------------------------------
legend_handles = [
    plt.Rectangle((0, 0), 1, 1, color=COLOR_HEX['blue']),
    plt.Rectangle((0, 0), 1, 1, color=COLOR_HEX['red']),
    plt.Rectangle((0, 0), 1, 1, color=COLOR_HEX['green']),
]
legend_labels = [
    'General Combination',
    'Bioinformatics + NGS Technologies + Phylogenomics Together',
    'Bioinformatics Only',
]
fig.legend(legend_handles, legend_labels, title='Highlighted Combinations',
           loc='lower center', ncol=3, fontsize=12, title_fontsize=13,
           frameon=True, bbox_to_anchor=(0.5, -0.02))

fig.text(0.5, -0.09,
          f"Total unique institutes: {total_institutes}  |  Each dot = a topic  |  "
          f"Connected dots = topics covered together  |  Bar height = number of "
          f"institutes with that exact combination",
          ha='center', fontsize=11, color='gray')

plt.tight_layout(rect=[0, 0.03, 1, 0.96])
plt.savefig('q9_genomics_upset.tif', dpi=300, format='tiff', bbox_inches='tight')
plt.savefig('q9_genomics_upset.png', dpi=200, bbox_inches='tight')
plt.show()

print("\n✅ Chart saved as q9_genomics_upset.tif (HD) and q9_genomics_upset.png (preview)")

